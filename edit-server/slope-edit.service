# /etc/systemd/system/slope-edit.service — install with edit-server/setup-pi.sh
[Unit]
Description=Slope in-game dev mode (sandboxed Claude Code editor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=slopeedit
Group=slopeedit
WorkingDirectory=/srv/slope-edit
EnvironmentFile=/srv/slope-edit/env            # SLOPE_EDIT_PASSWORD_HASH, token/USD caps, optional ANTHROPIC_API_KEY (root-owned, 0640 root:slopeedit)
Environment=HOME=/srv/slope-edit/home
Environment=SLOPE_EDIT_REPO=/srv/slope-edit/repo
Environment=SLOPE_EDIT_DATA=/srv/slope-edit/data
Environment=SLOPE_EDIT_CLAUDE=/srv/slope-edit/home/.npm-global/bin/claude
Environment=SLOPE_EDIT_CLAUDE_CONFIG=/srv/slope-edit/home/.claude
Environment=SLOPE_EDIT_SETTINGS=/srv/slope-edit/app/claude-settings.json
Environment=PATH=/srv/slope-edit/home/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /srv/slope-edit/app/server.js
Restart=on-failure
RestartSec=5

# --- containment: nothing outside /srv/slope-edit/{repo,data,home} is writable, no privilege gain,
#     no access to other users' homes (the game server, the NationStates manager, the user's files)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/slope-edit/repo /srv/slope-edit/data /srv/slope-edit/home
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete @cpu-emulation @debug
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1500M
TasksMax=256
CPUQuota=150%
UMask=0077

[Install]
WantedBy=multi-user.target
