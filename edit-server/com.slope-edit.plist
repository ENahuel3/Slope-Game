<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- /Library/LaunchDaemons/com.slope-edit.plist — the macOS counterpart of slope-edit.service; install with edit-server/setup-mac.sh -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.slope-edit</string>
    <key>UserName</key><string>slopeedit</string>
    <key>GroupName</key><string>slopeedit</string>
    <key>ProgramArguments</key>
    <array><string>/bin/bash</string><string>/opt/slope-edit/app/run-mac.sh</string></array>
    <key>WorkingDirectory</key><string>/opt/slope-edit</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>5</integer>
    <!-- Interactive: without it launchd clamps the daemon to background QoS and the headless game
         runs at 10-17 fps instead of 60 (smoke_check measured in the launchd context) -->
    <key>ProcessType</key><string>Interactive</string>
    <key>Nice</key><integer>5</integer>
    <key>Umask</key><integer>63</integer>
    <key>StandardOutPath</key><string>/opt/slope-edit/log/server.log</string>
    <key>StandardErrorPath</key><string>/opt/slope-edit/log/server.log</string>
</dict>
</plist>
